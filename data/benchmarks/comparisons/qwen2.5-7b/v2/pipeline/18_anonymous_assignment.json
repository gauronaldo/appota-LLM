  "turns": [
    {
      "id": "T1",
      "line": 1,
      "speaker": null,
      "speaker_label": "Người nói 1",
      "text": "Về kiểm thử, lỗi hiển thị giá đã được sửa trong bản mới."
    },
    {
      "id": "T2",
      "line": 2,
      "speaker": null,
      "speaker_label": "Người nói 2",
      "text": "Em đã xem bản sửa, cần chạy lại ba loại khuyến mãi."
    },
    {
      "id": "T3",
      "line": 3,
      "speaker": null,
      "speaker_label": "Người nói 3",
      "text": "Có thể kiểm tra bằng bộ dữ liệu mẫu đang dùng không?"
    },
    {
      "id": "T4",
      "line": 4,
      "speaker": null,
      "speaker_label": "Người nói 2",
      "text": "Có, không cần xin dữ liệu thật của khách."
    },
    {
      "id": "T5",
      "line": 5,
      "speaker": null,
      "speaker_label": "Người nói 1",
      "text": "Ai có thể nhận phần hồi quy này?"
    },
    {
      "id": "T6",
      "line": 6,
      "speaker": null,
      "speaker_label": "Người nói 2",
      "text": "Em nhận làm kiểm thử hồi quy trước thứ Sáu."
    },
    {
      "id": "T7",
      "line": 7,
      "speaker": null,
      "speaker_label": "Người nói 3",
      "text": "Em nghe rõ nội dung và hạn rồi."
    },
    {
      "id": "T8",
      "line": 8,
      "speaker": null,
      "speaker_label": "Người nói 1",
      "text": "Ba loại khuyến mãi là giảm phần trăm, giảm tiền và mua theo bộ đúng không?"
    },
    {
      "id": "T9",
      "line": 9,
      "speaker": null,
      "speaker_label": "Người nói 2",
      "text": "Đúng, mỗi loại cần thử cả lúc thêm và xóa sản phẩm."
    },
    {
      "id": "T10",
      "line": 10,
      "speaker": null,
      "speaker_label": "Người nói 3",
      "text": "Dữ liệu mẫu đã có sẵn đủ ba loại, không cần tạo đơn hàng thật."
    },
    {
      "id": "T11",
      "line": 11,
      "speaker": null,
      "speaker_label": "Người nói 1",
      "text": "Kết quả để trong bảng thử hiện tại để mình so với đợt trước."
    },
    {
      "id": "T12",
      "line": 12,
      "speaker": null,
      "speaker_label": "Người nói 2",
      "text": "Em đã thấy bảng đó, hạn em vừa nói là thứ Sáu."
    },
    {
      "id": "T13",
      "line": 13,
      "speaker": null,
      "speaker_label": "Người nói 3",
      "text": "Phần sửa code đã hoàn tất nên không đưa thành việc mới nữa."
    },
    {
      "id": "T14",
      "line": 14,
      "speaker": null,
      "speaker_label": "Người nói 1",
      "text": "Nếu có lỗi khác ngoài phạm vi này thì ghi riêng, đừng trộn vào kết quả hồi quy."
    },
    {
      "id": "T15",
      "line": 15,
      "speaker": null,
      "speaker_label": "Người nói 2",
      "text": "Không có thay đổi gì khác ở phần này."
    }
