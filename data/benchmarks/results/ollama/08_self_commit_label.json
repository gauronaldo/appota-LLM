  "turns": [
    {
      "id": "T1",
      "line": 1,
      "speaker": null,
      "speaker_label": "Người nói 1",
      "text": "Video lỗi giỏ hàng đã có trong nhóm, mọi người xem được chưa?"
    },
    {
      "id": "T2",
      "line": 2,
      "speaker": null,
      "speaker_label": "Người nói 2",
      "text": "Em xem rồi, lúc đổi số lượng thì tổng tiền không cập nhật."
    },
    {
      "id": "T3",
      "line": 3,
      "speaker": null,
      "speaker_label": "Người nói 3",
      "text": "Trên bản web hay bản điện thoại?"
    },
    {
      "id": "T4",
      "line": 4,
      "speaker": null,
      "speaker_label": "Người nói 2",
      "text": "Web. Em thử lại được bằng đúng sản phẩm trong video."
    },
    {
      "id": "T5",
      "line": 5,
      "speaker": null,
      "speaker_label": "Người nói 1",
      "text": "Như vậy có bằng chứng để xử lý, không cần đợi khách gửi thêm."
    },
    {
      "id": "T6",
      "line": 6,
      "speaker": null,
      "speaker_label": "Người nói 3",
      "text": "Phần tính tổng nằm cùng module với khuyến mãi."
    },
    {
      "id": "T7",
      "line": 7,
      "speaker": null,
      "speaker_label": "Người nói 2",
      "text": "Em đã đọc module đó trong đợt trước."
    },
    {
      "id": "T8",
      "line": 8,
      "speaker": null,
      "speaker_label": "Người nói 2",
      "text": "Để em xem lỗi này và báo lại chiều nay."
    },
    {
      "id": "T9",
      "line": 9,
      "speaker": null,
      "speaker_label": "Người nói 1",
      "text": "Có cần đổi người đang làm phần khuyến mãi không?"
    },
    {
      "id": "T10",
      "line": 10,
      "speaker": null,
      "speaker_label": "Người nói 2",
      "text": "Chưa cần, việc trước mắt là tìm chỗ không cập nhật."
    },
    {
      "id": "T11",
      "line": 11,
      "speaker": null,
      "speaker_label": "Người nói 3",
      "text": "Trong phiếu hỗ trợ có cả mã sản phẩm và thời điểm khách thao tác."
    },
    {
      "id": "T12",
      "line": 12,
      "speaker": null,
      "speaker_label": "Người nói 1",
      "text": "Mình cần biết nguyên nhân trước, chưa nhất thiết phải có bản sửa ngay."
    },
    {
      "id": "T13",
      "line": 13,
      "speaker": null,
      "speaker_label": "Người nói 2",
      "text": "Đúng, em sẽ báo lại những gì tái hiện được, không hứa một cách sửa khi chưa xem code."
    },
    {
      "id": "T14",
      "line": 14,
      "speaker": null,
      "speaker_label": "Người nói 3",
      "text": "Kết quả chiều nay có thể trao đổi trong luồng hỗ trợ này."
    },
    {
      "id": "T15",
      "line": 15,
      "speaker": null,
      "speaker_label": "Người nói 1",
      "text": "Được, hôm nay mình chỉ xử lý trường hợp trong video, chưa mở rộng sang mọi loại giỏ hàng."
    },
    {
      "id": "T16",
      "line": 16,
      "speaker": null,
      "speaker_label": "Người nói 2",
      "text": "Em đã rõ phạm vi đó."
    }
