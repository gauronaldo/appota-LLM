  "turns": [
    {
      "id": "T1",
      "line": 1,
      "speaker": null,
      "speaker_label": null,
      "text": "Đợt thử trước mình tích hợp cổng A vì tài liệu dễ đọc hơn."
    },
    {
      "id": "T2",
      "line": 2,
      "speaker": null,
      "speaker_label": null,
      "text": "Nếu tiếp tục A thì gần như không cần thay giao diện thanh toán."
    },
    {
      "id": "T3",
      "line": 3,
      "speaker": null,
      "speaker_label": null,
      "text": "Nhưng phí giao dịch tháng vừa rồi cao hơn con số trong báo giá ban đầu."
    },
    {
      "id": "T4",
      "line": 4,
      "speaker": null,
      "speaker_label": null,
      "text": "Có tính cả phí tối thiểu theo tháng không?"
    },
    {
      "id": "T5",
      "line": 5,
      "speaker": null,
      "speaker_label": null,
      "text": "Có, bên kế toán đã cộng vào rồi."
    },
    {
      "id": "T6",
      "line": 6,
      "speaker": null,
      "speaker_label": null,
      "text": "Cổng B có hỗ trợ hoàn tiền một phần không?"
    },
    {
      "id": "T7",
      "line": 7,
      "speaker": null,
      "speaker_label": null,
      "text": "Bên họ xác nhận có, nhưng mình phải gọi thêm một API."
    },
    {
      "id": "T8",
      "line": 8,
      "speaker": null,
      "speaker_label": null,
      "text": "Nhóm tích hợp có đủ thời gian cho thay đổi này trước đợt thử tiếp không?"
    },
    {
      "id": "T9",
      "line": 9,
      "speaker": null,
      "speaker_label": null,
      "text": "Nếu chỉ làm luồng thanh toán và hoàn tiền thì có thể."
    },
    {
      "id": "T10",
      "line": 10,
      "speaker": null,
      "speaker_label": null,
      "text": "Vậy chuyển sang B có vẻ hợp lý hơn cho đợt tiếp."
    },
    {
      "id": "T11",
      "line": 11,
      "speaker": null,
      "speaker_label": null,
      "text": "Đừng bỏ qua phần đối soát; lần trước lỗi nằm ở đó."
    },
    {
      "id": "T12",
      "line": 12,
      "speaker": null,
      "speaker_label": null,
      "text": "Bên B có file đối soát mẫu, mình đã đọc cấu trúc."
    },
    {
      "id": "T13",
      "line": 13,
      "speaker": null,
      "speaker_label": null,
      "text": "Phí đã được xác nhận bằng email, không còn là giá tạm tính."
    },
    {
      "id": "T14",
      "line": 14,
      "speaker": null,
      "speaker_label": null,
      "text": "Chốt chuyển sang cổng B cho đợt thử tiếp theo."
    },
    {
      "id": "T15",
      "line": 15,
      "speaker": null,
      "speaker_label": null,
      "text": "Cổng A vẫn giữ cho giao dịch cũ, không xóa lịch sử."
    },
    {
      "id": "T16",
      "line": 16,
      "speaker": null,
      "speaker_label": null,
      "text": "Nếu có vấn đề ở môi trường thử thì phải báo lại, không tự đổi sang A."
    },
    {
      "id": "T17",
      "line": 17,
      "speaker": null,
      "speaker_label": null,
      "text": "Ghi giúp phần quyết định này để người vắng mặt biết."
    }
  ],
