  "turns": [
    {
      "id": "T1",
      "line": 1,
      "speaker": null,
      "speaker_label": null,
      "text": "Bản hướng dẫn hiện vẫn có ảnh của giao diện cũ."
    },
    {
      "id": "T2",
      "line": 2,
      "speaker": null,
      "speaker_label": null,
      "text": "Khách dùng ảnh đó để tìm nút nên dễ bấm nhầm chỗ."
    },
    {
      "id": "T3",
      "line": 3,
      "speaker": null,
      "speaker_label": null,
      "text": "Phần nội dung chữ đã đúng, chỉ cần thay ảnh ở ba bước."
    },
    {
      "id": "T4",
      "line": 4,
      "speaker": null,
      "speaker_label": null,
      "text": "Ai có thể làm phần đó trước khi gửi cho khách?"
    },
    {
      "id": "T5",
      "line": 5,
      "speaker": null,
      "speaker_label": null,
      "text": "Em nhận thay ảnh hướng dẫn trước ngày mai."
    },
    {
      "id": "T6",
      "line": 6,
      "speaker": null,
      "speaker_label": null,
      "text": "Có cần viết lại toàn bộ tài liệu không?"
    },
    {
      "id": "T7",
      "line": 7,
      "speaker": null,
      "speaker_label": null,
      "text": "Không, chỉ thay ba ảnh rồi kiểm tra lại thứ tự bước."
    },
    {
      "id": "T8",
      "line": 8,
      "speaker": null,
      "speaker_label": null,
      "text": "Người nhận việc có quyền mở tài liệu chung rồi."
    },
    {
      "id": "T9",
      "line": 9,
      "speaker": null,
      "speaker_label": null,
      "text": "Ảnh mới cần chụp ở màn hình điện thoại hay máy tính?"
    },
    {
      "id": "T10",
      "line": 10,
      "speaker": null,
      "speaker_label": null,
      "text": "Khách đang dùng máy tính, lần này mình chụp màn hình máy tính."
    },
    {
      "id": "T11",
      "line": 11,
      "speaker": null,
      "speaker_label": null,
      "text": "Vậy ảnh ở phần đăng nhập cũng dùng máy tính cho nhất quán nhé."
    },
    {
      "id": "T12",
      "line": 12,
      "speaker": null,
      "speaker_label": null,
      "text": "Đúng, chỉ thay ảnh thôi, không đổi những hướng dẫn đã được khách kiểm tra."
    },
    {
      "id": "T13",
      "line": 13,
      "speaker": null,
      "speaker_label": null,
      "text": "Nếu có một bước không khớp giao diện thì đánh dấu để mình xem lại."
    },
    {
      "id": "T14",
      "line": 14,
      "speaker": null,
      "speaker_label": null,
      "text": "Không có quyết định sản phẩm mới trong phần trao đổi này."
    },
    {
      "id": "T15",
      "line": 15,
      "speaker": null,
      "speaker_label": null,
      "text": "Mình kết thúc ở đây, tài liệu mới vẫn lưu cùng thư mục với bản hiện tại."
    }
  ],
