  "turns": [
    {
      "id": "T1",
      "line": 1,
      "speaker": null,
      "speaker_label": null,
      "text": "Khách muốn tải toàn bộ báo cáo theo tháng, nhưng file có thể rất lớn."
    },
    {
      "id": "T2",
      "line": 2,
      "speaker": null,
      "speaker_label": null,
      "text": "Hay mình chia thành từng tuần rồi để khách tải nhiều file nhỏ?"
    },
    {
      "id": "T3",
      "line": 3,
      "speaker": null,
      "speaker_label": null,
      "text": "Như vậy họ phải ghép lại, phía khách đang dùng Excel thủ công."
    },
    {
      "id": "T4",
      "line": 4,
      "speaker": null,
      "speaker_label": null,
      "text": "Nếu dùng một file thì giới hạn dung lượng cần kiểm tra trước."
    },
    {
      "id": "T5",
      "line": 5,
      "speaker": null,
      "speaker_label": null,
      "text": "Con số trong tài liệu là giới hạn lý thuyết, chưa có phép thử của mình."
    },
    {
      "id": "T6",
      "line": 6,
      "speaker": null,
      "speaker_label": null,
      "text": "Một bên lo khách phải thao tác nhiều, một bên lo tải file bị treo."
    },
    {
      "id": "T7",
      "line": 7,
      "speaker": null,
      "speaker_label": null,
      "text": "Cả hai lo ngại đều có cơ sở, chưa đủ dữ liệu để bỏ một bên."
    },
    {
      "id": "T8",
      "line": 8,
      "speaker": null,
      "speaker_label": null,
      "text": "Người phụ trách phía khách hôm nay không tham gia."
    },
    {
      "id": "T9",
      "line": 9,
      "speaker": null,
      "speaker_label": null,
      "text": "Mình cần hiểu họ dùng dữ liệu để làm gì trước khi chọn cách tải."
    },
    {
      "id": "T10",
      "line": 10,
      "speaker": null,
      "speaker_label": null,
      "text": "Chưa có ai cam kết làm chức năng tải theo tuần."
    },
    {
      "id": "T11",
      "line": 11,
      "speaker": null,
      "speaker_label": null,
      "text": "Đừng ghi đề xuất đầu cuộc họp thành công việc của nhóm giao diện."
    },
    {
      "id": "T12",
      "line": 12,
      "speaker": null,
      "speaker_label": null,
      "text": "Hôm nay chưa thống nhất cách xuất báo cáo, mình giữ cả hai lựa chọn để hỏi khách."
    },
    {
      "id": "T13",
      "line": 13,
      "speaker": null,
      "speaker_label": null,
      "text": "Các yêu cầu hiện tại chưa đủ để xác định định dạng cuối."
    },
    {
      "id": "T14",
      "line": 14,
      "speaker": null,
      "speaker_label": null,
      "text": "Trong biên bản ghi rõ phần này còn mở."
    },
    {
      "id": "T15",
      "line": 15,
      "speaker": null,
      "speaker_label": null,
      "text": "Mình vẫn chưa biết khách cần tải một lần hay tải lặp lại hằng tuần."
    },
    {
      "id": "T16",
      "line": 16,
      "speaker": null,
      "speaker_label": null,
      "text": "Mình kết thúc cuộc họp ở đây."
    }
  ],
